# Kennwort des Scan-Kontos (zap-eigen) für die angemeldeten ZAP-Läufe.
# Kopieren nach pw.env und auf das Testpasswort aus dem Seed setzen
# (PENTEST_PASSWORD, Vorgabe "pentest-local-9z").
#
#   cp pw.env.example pw.env
#
# pw.env ist in .gitignore – nur die .example-Vorlage gehört ins Repo.
GB_PW=pentest-local-9z
