# Vorlage für den lokalen Test-Stack. Kopieren nach stack.env und APP_KEY setzen.
# Nur für lokale Wegwerf-Instanzen. Keine echten Zugangsdaten eintragen.
#
#   cp stack.env.example stack.env
#   # gültigen Schlüssel erzeugen:
#   APP_KEY="base64:$(openssl rand -base64 32)"  -> in stack.env eintragen

APP_NAME=Swayy
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://host.docker.internal:8088
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

DB_DATABASE=gastrobook
DB_USERNAME=gastrobook
DB_PASSWORD=pentest-local-db-pw

SESSION_SECURE_COOKIE=false
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@gastrobook.test"
CAP_ENABLED=false

# Web lauscht auf 0.0.0.0:8088, damit die Scanner-Container das Ziel über
# host.docker.internal:8088 erreichen.
SWAYY_BIND=0.0.0.0
SWAYY_PORT=8088
SWAYY_HEALTH_HOST=host.docker.internal

# Zu testende Fassung (eigenes Image bauen oder eine veröffentlichte nehmen).
GASTROBOOK_IMAGE=ghcr.io/brightcolor/gastrobook:latest
