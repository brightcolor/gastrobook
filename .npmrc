ignore-scripts=true
audit=true

# Neue Paketversionen erst auflösen, wenn sie sieben Tage veröffentlicht sind
# (npm ab 11.10). npm ci installiert weiter genau die Versionen aus
# package-lock.json. Für ein dringendes Update auf eine jüngere Version:
# npm install <paket>@<version> --min-release-age=0
min-release-age=7
